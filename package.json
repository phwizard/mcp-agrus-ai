{
  "name": "mcp-agrus-ai",
  "version": "0.2.0",
  "description": "Model Context Protocol server for Agrus.ai. Lets AI agents engage the agency directly: list services, query compliance positions on HIPAA / SOC 2 / ISO 27001 / EU AI Act / NAIC / ABA / AML, scope a PoC, request a quote, or formally request a proposal.",
  "mcpName": "io.github.phwizard/mcp-agrus-ai",
  "type": "module",
  "bin": {
    "mcp-agrus-ai": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run test && npm run build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agrus",
    "ai-consulting",
    "ai-agents",
    "anthropic",
    "claude"
  ],
  "author": "Dappros Ltd",
  "license": "MIT",
  "homepage": "https://agrus.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phwizard/mcp-agrus-ai.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7",
    "vitest": "^4.1.6"
  }
}
